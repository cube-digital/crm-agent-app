# Copy to .env and fill in. docker-compose picks it up automatically.

# Postgres (sample CRM DB)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_PORT=5432

# FalkorDB (graph)
FALKORDB_PORT=6379
FALKORDB_UI_PORT=3000
FALKORDB_GRAPH=crm

# App
APP_PORT=8000

# LLM provider — set ONE of these depending on which provider your agent uses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
