# Copy to .env and fill in. docker-compose picks it up automatically.

# Postgres (sample CRM DB)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_PORT=5432

# FalkorDB (graph)
# Leave HOST/USERNAME/PASSWORD blank to use the local `falkordb` compose service.
# Set them to point the app at a remote FalkorDB instance instead.
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_UI_PORT=3000
FALKORDB_GRAPH=crm

# App
APP_PORT=8000

# Auth — sign JWTs with this. Generate a real one: `openssl rand -hex 32`.
JWT_SECRET=

# Proactive agent
PROACTIVE_SCAN_INTERVAL_SECONDS=600
PROACTIVE_TOP_N=3

# LLM provider — the agent uses Anthropic. Set your key here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
